#!/usr/bin/env ruby
# frozen_string_literal: true

# Full podcast pipeline: ingest → transcribe → analyze → digest email
# Usage:
#   ruby bin/run_podcast_pipeline                  # process all new episodes
#   LIMIT=3 ruby bin/run_podcast_pipeline          # limit transcription + analysis to 3 episodes

$LOAD_PATH.unshift(File.join(__dir__, "..", "lib"))

require "dotenv/load"
require "podcast_ingestor"
require "transcript_service"
require "analysis_service"
require "digest_builder"
require "database"

limit = ENV["LIMIT"]&.to_i
target = limit || 3

puts "=" * 60
puts "VC Podcast Pipeline — #{Time.now.strftime('%Y-%m-%d %H:%M')}"
puts "=" * 60
puts

# Step 1: Ingest new episodes from RSS feeds
puts "--- Step 1: Ingest RSS Feeds ---"
VCTools::Podcast::Ingestor.new.run
puts

# Step 2: Transcribe new episodes
puts "--- Step 2: Transcribe Episodes ---"
VCTools::Podcast::TranscriptService.new.run(limit: target)
puts

# Step 3: Analyze transcribed episodes
puts "--- Step 3: Analyze Episodes ---"
VCTools::Podcast::AnalysisService.new.run(limit: target)
puts

# Step 3b: Backfill — if any episodes failed analysis, transcribe+analyze more
#          until we have enough analyzed episodes for the digest
db = VCTools::Podcast::Database.connect
today_midnight = Time.new(Time.now.year, Time.now.month, Time.now.day, 0, 0, 0).utc
max_backfill_attempts = 5

max_backfill_attempts.times do |attempt|
  analyzed_today = db[:episodes].where(status: "analyzed").where { updated_at >= today_midnight }.count
  remaining = db[:episodes].where(status: "new").count

  break if analyzed_today >= target
  break if remaining == 0

  puts "--- Backfill #{attempt + 1}: #{analyzed_today}/#{target} analyzed, picking another episode ---"
  VCTools::Podcast::TranscriptService.new.run(limit: 1)
  VCTools::Podcast::AnalysisService.new.run(limit: 1)
  puts
end

analyzed_today = db[:episodes].where(status: "analyzed").where { updated_at >= today_midnight }.count
puts "[Pipeline] #{analyzed_today} episodes analyzed today"
puts

# Step 4: Build and send daily digest
puts "--- Step 4: Build & Send Digest ---"
VCTools::Podcast::DigestBuilder.new.run
puts

puts "=" * 60
puts "Pipeline complete"
puts "=" * 60
